--- a/board.toml
+++ b/board.toml
@@ -92,6 +92,7 @@
 BUILDID_STRING = "lmipro-research"
 
 [payload]
+panic_screen = true
 volume = "LMIPROESP"
 # boot is 128 MiB on this handset (single slot; from fastboot getvar
 # partition-size:boot = 0x8000000). 64 MiB matches the 64 MiB the firmware
@@ -100,7 +101,7 @@
 size_mib = 64
 loader = "firmware"
 title = "Redmi K30 Pro"
-kernel_args = ["-v", "serial=3"]
+kernel_args = ["-v", "serial=3", "boot-progress=2", "lmipro-ufs-root=1", "sheng-pmgr=2"]
 
 [payload.adt]
 # scratch-data.img is DBR packed sparse data, not raw APFS bytes.
