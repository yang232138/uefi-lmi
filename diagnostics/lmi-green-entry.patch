--- a/board.toml
+++ b/board.toml
@@ -81,10 +81,12 @@
 loader = "firmware"
 title = "Redmi K30 Pro"
 kernel_args = ["-v", "serial=3", "boot-progress=2"]
-# entry_probe_reset_delay is deliberately absent: the probe resets the phone a
-# few seconds into the kernel, which would hide any later stage.
-# panic_screen is off: its entry-probe patch stalls the kernel before the MMU
-# is enabled, which hides the very failures it is meant to show.
+# Official stage4 checkpoint: after serial_init returns in arm_init.
+# Only the official call-site checkpoint changes; actual kernel is unchanged.
+entry_probe_reset_delay = 6
+entry_probe_reset_after = "_serial_init"
+entry_probe_reset_in = "_arm_init"
+entry_probe_reset_occurrence = 1
 panic_screen = false
 
 [payload.adt]
